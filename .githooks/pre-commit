#!/bin/sh
# Blocks claude-flow's generated scaffolding from entering project history.
#
# These paths are gitignored, so a plain `git add` cannot stage them. This hook
# is the backstop for `git add -f` and for any tooling that stages on our behalf
# -- during one session 309 such files appeared in the index unprompted, and the
# process responsible was never identified, so the guard does not assume a cause.
#
# Bespoke project tooling (CLAUDE.md, .mcp.json, scripts/) is deliberately
# tracked and is NOT blocked here. .claude/settings.json is also tracked, and so
# was removed from the blocklist: it is the only place the hook wiring lives, and
# without it a clone gets scripts/ with nothing invoking them.
#
# The 309 files above were staged by a Claude Code session copying this config in
# from another repo; see the reflog around the chore/claude-code-config branch.
# The guard stays regardless -- the cause being known does not make it unneeded.
#
# Override for a single commit with: ALLOW_CLAUDE_SCAFFOLD=1 git commit ...

[ "${ALLOW_CLAUDE_SCAFFOLD:-0}" = "1" ] && exit 0

blocked=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^\.claude/(agents|commands|helpers|skills)/|^\.claude/scheduled_tasks\.lock$' \
  || true)

if [ -n "$blocked" ]; then
    count=$(printf '%s\n' "$blocked" | wc -l | tr -d ' ')
    echo "pre-commit: refusing to commit $count generated claude-flow file(s)." >&2
    echo "" >&2
    printf '%s\n' "$blocked" | head -10 | sed 's/^/  /' >&2
    [ "$count" -gt 10 ] && echo "  ... and $((count - 10)) more" >&2
    echo "" >&2
    echo "These are regenerated by 'claude-flow init' and are gitignored." >&2
    echo "Unstage with:  git reset HEAD -- .claude/" >&2
    echo "Override with: ALLOW_CLAUDE_SCAFFOLD=1 git commit ..." >&2
    exit 1
fi

exit 0
