{
  // Type-checks the client's JavaScript (roadmap lane D1, decision record 0017).
  // A file is checked when `// @ts-check` sits below its header; every other
  // file is read for its types and reports nothing. Nothing is built from this
  // file: Vite and Vitest transform the sources themselves. `types` loads Vite's
  // own declarations (CSS and asset imports, import.meta.env) and the PWA
  // plugin's virtual module, and Node's, for the checked server files a client
  // JSDoc type reaches (dashboardDataBuildersService.js imports crypto). It also
  // loads the server's Request fields, for the route modules a client type names.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["vite/client", "vite-plugin-pwa/react", "node"]
  },
  "include": ["src", "../server/src/types/express.d.ts"]
}
