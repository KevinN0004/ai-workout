{
  // Type-checks the client's JavaScript (roadmap lane D1, decision record 0017).
  // Every file under `src` is checked (milestone M4); there is no pragma to add.
  // Nothing is built from this file: Vite and Vitest transform the sources
  // themselves. `types` loads Vite's own declarations (CSS and asset imports,
  // import.meta.env) and the PWA plugin's virtual module, and Node's, for the
  // server files a client JSDoc type reaches (dashboardDataBuildersService.js
  // imports crypto). It also loads the server's Request fields, for the route
  // modules a client type names.
  // The tests are checked by `tsconfig.test.json`.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["vite/client", "vite-plugin-pwa/react", "node"]
  },
  "include": ["src", "../server/src/types/express.d.ts"],
  "exclude": ["src/**/*.test.js", "src/**/*.test.jsx", "src/**/__tests__/**", "src/test/**"]
}
