{
  "name": "ai-workout-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "postgres:local:start": "powershell -ExecutionPolicy Bypass -File scripts/start-local-postgres.ps1",
    "migrate:postgres": "node scripts/apply-postgres-migrations.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "node scripts/refuse-db-push.js",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^11.11.0",
    "argon2": "^0.45.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  }
}
